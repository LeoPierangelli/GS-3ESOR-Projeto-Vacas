            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacaId\": 2,\n  \"dataHora\": \"{{agora}}\",\n  \"turno\": \"MANHA\",\n  \"litros\": 9.0,\n  \"condutividade\": 0.402\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('nenhum alerta', () => pm.expect(pm.response.json().alertasGerados).to.have.lengthOf(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Condutividade alta (SUSPEITA_MASTITE)",
          "request": {
            "method": "POST",
            "header": [
              {
