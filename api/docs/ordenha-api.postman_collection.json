  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(Date.now() - 60000);",
          "const p = n => String(n).padStart(2, '0');",
          "const hoje = `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;",
          "pm.collectionVariables.set('hoje', hoje);",
          "pm.collectionVariables.set('agora', `${hoje}T${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`);"
        ]
      }
    }
  ]
