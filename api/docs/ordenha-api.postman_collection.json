{
  "info": {
    "name": "Ordenha Monitorada API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode 'Auth > Login (João)' primeiro: o token é salvo sozinho na variável {{token}}."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "vacaId",
      "value": ""
    },
    {
      "key": "agora",
      "value": ""
    },
    {
      "key": "hoje",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro de usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Lima\",\n  \"email\": \"ana@exemplo.com\",\n  \"senha\": \"senhaforte1\",\n  \"propriedade\": {\n    \"nome\": \"Sítio Esperança\",\n    \"municipio\": \"Lavras\",\n    \"uf\": \"MG\"\n  }\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (João)",
          "request": {
            "method": "POST",
            "header": [
