            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacaId\": 2,\n  \"dataHora\": \"{{agora}}\",\n  \"turno\": \"MANHA\",\n  \"litros\": 8.6,\n  \"condutividade\": 0.48\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('gerou SUSPEITA_MASTITE', () => pm.expect(pm.response.json().alertasGerados.map(a => a.tipo)).to.include('SUSPEITA_MASTITE'));"
                ]
              }
            }
          ]
        },
